# ── Required ────────────────────────────────────────────────────────────────
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AA-your-bot-token-here
# VirusTotal API key (https://www.virustotal.com/gui/my-apikey)
VIRUSTOTAL_API_KEY=your-virustotal-api-key
# Comma-separated Telegram user ids and/or chat ids allowed to trigger scans.
# Send /id to the bot to see your ids. Group chats have negative ids.
AUTHORIZED_IDS=123456789

# ── Optional (defaults shown) ───────────────────────────────────────────────
# GLM AI summary: set GLM_API_KEY to append a plain-language risk assessment
# (model glm-5.3-flash) under each scan report. Leave unset to disable.
GLM_API_KEY=
# Zhipu open-platform endpoint and model
GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.3-flash
GLM_TIMEOUT_SECONDS=30
GLM_SUMMARY_MAX_CHARS=600
# Allow the bot to upload APKs to VirusTotal for fresh analysis.
# Set to false for hash-lookup-only mode (private/confidential APK policy).
ALLOW_UPLOADS=true
# Reply to unauthorized senders (false = ignore silently)
UNAUTHORIZED_REPLY=true
# Seconds between analysis status polls (VT public quota is 4 requests/min)
VT_POLL_INTERVAL_SECONDS=20
# Give up waiting for an analysis after this many seconds
VT_POLL_TIMEOUT_SECONDS=300
# Retries for transient VirusTotal errors (5xx, network)
VT_MAX_RETRIES=3
# Reuse an existing VT report if it is newer than this many hours (0 = always reuse)
VT_REUSE_MAX_AGE_HOURS=24
# Malicious-engine count that classifies a file as MALICIOUS; 1..threshold-1 => SUSPICIOUS
MALICIOUS_THRESHOLD=3
# Suspicious-engine count that classifies a file as SUSPICIOUS
SUSPICIOUS_THRESHOLD=1
# Hard size cap per APK in bytes (Telegram bots can download at most 20 MB)
MAX_APK_BYTES=20971520
# Minutes to remember recent scan results for duplicate files
CACHE_TTL_MINUTES=30
# Log level: debug | info | warn | error
LOG_LEVEL=info
